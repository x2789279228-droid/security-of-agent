# ════════════════════════════════════════════
# 开发专用 Dockerfile — vite dev server (HMR 热更新)
#   与 Dockerfile 共享 package.json / package-lock.json, 但运行时是 node 而非 nginx
#   用法: docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build frontend
#
# 加速:
#   - 使用阿里云 npmmirror 国内源 (registry.npmmirror.com) 避免 npm 官方源网络慢
#   - COPY package*.json 与 COPY . . 分离, 利用 Docker layer cache: 改 src 代码不重装依赖
# ════════════════════════════════════════════
FROM node:22-alpine

# 阿里云 npmmirror 国内源 (替代默认 registry.npmjs.org)
#   解决 npm ci 在国内网络下慢甚至超时问题 (3-10x 加速)
RUN npm config set registry https://registry.npmmirror.com

WORKDIR /app

# 单独 COPY 依赖文件, 先装依赖 — 改 src 时这一层不会失效
COPY package.json package-lock.json ./
# --prefer-offline: 优先用本地缓存, 避免重复下载
RUN npm ci --no-audit --no-fund --prefer-offline

# 复制源码 (dev 模式也会被 bind mount 覆盖, 这一步主要是给 image 留一份基准)
COPY . .

EXPOSE 3000

# vite dev server: --host 0.0.0.0 让容器外可访问, --port 3000 与 docker-compose.dev.yml ports 对应
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
