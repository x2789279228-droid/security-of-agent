<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.soc</groupId>
    <artifactId>flink-jobs</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>SOC Flink Jobs</name>
    <description>安全运营中心 Flink 流处理作业 - 日志验证与异常检测</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <flink.version>1.20.5</flink.version>
        <flink.jackson.version>2.14.2-17.0</flink.jackson.version>
        <kafka.connector.version>3.3.0-1.20</kafka.connector.version>
        <opentelemetry.version>1.40.0</opentelemetry.version>
    </properties>

    <dependencies>
        <!-- Flink 核心流处理 (运行时由 Flink 集群提供) -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-streaming-java</artifactId>
            <version>${flink.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Flink Kafka 连接器 (新版 KafkaSource/KafkaSink API)
             注意: 必须为 provided 并从 fat jar 中排除, 否则 kafka-clients 类被
             客户端与 JobManager 双类加载器加载, 导致 OffsetResetStrategy 反序列化
             ClassCastException。运行时由 /opt/flink/lib 统一提供。 -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-kafka</artifactId>
            <version>${kafka.connector.version}</version>
            <scope>provided</scope>
            <exclusions>
                <!-- 排除 abandon 且无修复版的 org.lz4:lz4-java (CVE-2026-59949, fix not available);
                     改由下方 at.yawk.lz4:lz4-java:1.11.1 提供 (修复版新坐标)。 -->
                <exclusion>
                    <groupId>org.lz4</groupId>
                    <artifactId>lz4-java</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Kafka 客户端 (与连接器版本匹配, 由 Flink lib 目录提供, 不打入 fat jar) -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>3.4.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- lz4-java: Kafka 消息压缩/解压库。org.lz4 坐标已 abandon 且无 CVE-2026-59949 修复版,
             改用社区迁移目标 at.yawk.lz4:lz4-java:1.11.1 (fix, API 向后兼容 kafka-clients 3.4.0)。
             显式锁定确保 kafka-deps 不解析回受影响版本。 -->
        <dependency>
            <groupId>at.yawk.lz4</groupId>
            <artifactId>lz4-java</artifactId>
            <version>1.11.1</version>
        </dependency>

        <!-- flink-connector-base: KafkaSink 的 DeliveryGuarantee 枚举所在包
             (provided 依赖不传递, 需显式声明; 运行时由 Flink 发行版 lib 提供) -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-base</artifactId>
            <version>${flink.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Flink CEP 复杂事件处理 - 攻击链检测 (运行时由 Flink 集群提供) -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-cep</artifactId>
            <version>${flink.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Jackson JSON 序列化/序列化: 用 flink-shaded-jackson (relocate 版本, provided)。
             运行时由 Flink dist 提供 (org.apache.flink.shaded.jackson2.com.fasterxml.*)。
             绝不能打入 fat job jar / 放 /opt/flink/lib —— 否则 com.fasterxml 原始版会与
             Flink 运行时依赖冲突 → NoSuchMethodError (如 getNumberTypeFP / BufferRecycler.releaseToPool)。 -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-shaded-jackson</artifactId>
            <version>${flink.jackson.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- 日志 (运行时由 Flink 集群提供, 避免 SLF4J 双绑定) -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>1.7.36</version>
            <scope>provided</scope>
        </dependency>

        <!-- OpenTelemetry SDK: 每事件标准 span (→ otel-collector → Tempo)
             打入 fat jar, 由作业类加载器隔离, 与 Flink lib 的 OTel 系统 reporter 不冲突 -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
            <version>${opentelemetry.version}</version>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk</artifactId>
            <version>${opentelemetry.version}</version>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
            <version>${opentelemetry.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Maven Shade 插件 - 构建 fat JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <!-- 默认主类: 日志验证作业 -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.soc.job.LogValidationJob</mainClass>
                                </transformer>
                                <!-- 合并 META-INF/services 文件 -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 编译插件 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>11</source>
                    <target>11</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- 拷贝 Kafka 连接器及客户端到 target/kafka-deps, 由 Docker 放入 /opt/flink/lib -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-kafka-deps</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeGroupIds>org.apache.kafka,org.apache.flink,at.yawk.lz4,org.xerial.snappy,com.github.luben</includeGroupIds>
                            <outputDirectory>${project.build.directory}/kafka-deps</outputDirectory>
                            <stripVersion>false</stripVersion>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
